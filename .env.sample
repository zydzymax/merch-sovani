# Database
DATABASE_URL="postgresql://fashion_user:fashion_pass@localhost:5434/fashion_db?schema=public"

# Redis
REDIS_URL="redis://localhost:6381"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Auth
JWT_SECRET="your-super-secret-jwt-key-change-me-in-production"
SESSION_SECRET="your-session-secret-change-me"

# Payment - YooKassa (Яндекс.Касса)
PAYMENT_PROVIDER="yukassa" # yukassa | mock
YUKASSA_SHOP_ID="your-shop-id"
YUKASSA_SECRET_KEY="your-secret-key"

# Email
EMAIL_PROVIDER="smtp" # smtp | resend
SMTP_HOST="smtp.yandex.ru"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="noreply@yourdomain.ru"
SMTP_PASS="your-smtp-password"
SMTP_FROM="Fashion Shop <noreply@yourdomain.ru>"

# Resend (alternative)
RESEND_API_KEY="re_xxx"

# Yandex.Metrika
NEXT_PUBLIC_YANDEX_METRIKA_ID="12345678"

# Promo settings
PROMO_ACTIVE="true"
PROMO_ENDS_AT="2025-12-31T23:59:59Z"

# Admin
ADMIN_EMAIL="admin@yourdomain.ru"
ADMIN_PASSWORD="change-me-admin-password"

# Shipping
SHIPPING_POCHTA_RF_ENABLED="true"
SHIPPING_POCHTA_RF_PRICE="0"
