// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
  SELLER
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  MOCK
  YUKASSA
}

enum ShipmentStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  RETURNED
}

enum DrawStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ProductCategory {
  CLOTHING
  SUPPLEMENTS
}

// ==================== USERS & AUTH ====================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String?   // legacy
  passwordHash  String?   // NextAuth bcrypt hash
  emailVerified DateTime?
  name          String?
  phone         String?
  role          UserRole  @default(CUSTOMER)
  referralCode  String?   @unique // for referral system
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  // Seller fields (для продавцов на маркетплейсе)
  companyName      String?   // ИП/ООО
  inn              String?   // ИНН
  ogrn             String?   // ОГРН/ОГРНИП
  legalAddress     String?   // Юридический адрес
  bankAccount      String?   // Расчетный счет
  bankName         String?   // Название банка
  bankBik          String?   // БИК банка
  bankCorAccount   String?   // Корр. счет
  offerAcceptedAt  DateTime? // Дата принятия оферты

  addresses        Address[]
  orders           Order[]
  entries          Entry[]
  referralLinks    ReferralLink[]
  sessions         Session[]
  accounts         Account[]  // NextAuth
  referralsFrom    Referral[] @relation("UserReferralsFrom")
  referralsTo      Referral[] @relation("UserReferralsTo")
  sellerProducts   Product[] @relation("SellerProducts")
  payouts          Payout[]

  @@index([email])
  @@index([referralCode])
  @@index([role])
  @@map("users")
}

model Session {
  id           String    @id @default(cuid())
  userId       String?
  sessionToken String?   @unique // NextAuth
  sessionId    String?   @unique // legacy
  expiresAt    DateTime?
  expires      DateTime? // NextAuth
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  cart CartItem[]

  @@index([sessionToken])
  @@index([sessionId])
  @@index([userId])
  @@map("sessions")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Referral {
  id                   String   @id @default(cuid())
  referrerId           String
  referredId           String
  firstPurchaseCounted Boolean  @default(false)

  // Antifraud fields
  fraudChecked         Boolean  @default(false)
  fraudScore           Int      @default(0) // 0-100, higher = more suspicious
  fraudReason          String? // "self_referral", "same_ip", "same_device", etc.
  isValid              Boolean  @default(true)

  createdAt            DateTime @default(now())

  referrer User @relation("UserReferralsFrom", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User @relation("UserReferralsTo", fields: [referredId], references: [id], onDelete: Cascade)

  @@unique([referrerId, referredId])
  @@index([referrerId])
  @@index([referredId])
  @@index([isValid])
  @@map("referrals")
}

model Address {
  id         String    @id @default(cuid())
  userId     String
  fullName   String
  phone      String
  country    String    @default("RU")
  region     String
  city       String
  address    String
  postalCode String
  isDefault  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders   Order[]

  @@index([userId])
  @@map("addresses")
}

// ==================== PRODUCTS ====================

model Product {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  description String?         @db.Text
  category    ProductCategory
  images      String[]
  features    Json?
  seoTitle    String?
  seoDesc     String?
  isActive    Boolean         @default(true)
  isFeatured  Boolean         @default(false)

  // Marketplace-like product details
  material    String?         // Материал изготовления
  brand       String?         // Бренд
  country     String?         // Страна производства
  care        String?         @db.Text // Уход за товаром
  composition String?         @db.Text // Состав

  // Seller information
  sellerId      String?         // ID селлера (владельца товара)
  sellerName    String?         // ИП или ООО
  sellerInn     String?         // ИНН продавца
  sellerOgrn    String?         // ОГРН/ОГРНИП
  sellerAddress String?         // Юридический адрес

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  variants Variant[]
  seller   User?     @relation("SellerProducts", fields: [sellerId], references: [id])

  @@index([slug])
  @@index([category])
  @@index([isActive])
  @@index([sellerId])
  @@map("products")
}

model Variant {
  id          String   @id @default(cuid())
  productId   String
  sku         String   @unique
  name        String?
  size        String?
  color       String?
  price       Int // в копейках
  compareAt   Int? // старая цена
  images      String[]
  attributes  Json? // дополнительные атрибуты
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)

  // Shipping dimensions (for CDEK and other carriers)
  weight      Int?     // вес в граммах
  length      Int?     // длина в см
  width       Int?     // ширина в см
  height      Int?     // высота в см

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory    Inventory?
  orderItems   OrderItem[]
  cartItems    CartItem[]

  @@index([sku])
  @@index([productId])
  @@map("variants")
}

model Inventory {
  id        String   @id @default(cuid())
  variantId String   @unique
  quantity  Int      @default(0)
  reserved  Int      @default(0) // зарезервировано в корзинах
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@map("inventory")
}

// ==================== CART ====================

model CartItem {
  id        String   @id @default(cuid())
  sessionId String
  variantId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([sessionId, variantId])
  @@index([sessionId])
  @@map("cart_items")
}

// ==================== ORDERS ====================

model Order {
  id                   String      @id @default(cuid())
  orderNumber          String      @unique // ORDER-20250101-XXXX
  userId               String?
  sessionId            String?
  email                String
  phone                String
  status               OrderStatus @default(PENDING)

  // Shipping
  addressId            String?
  shippingMethod       String? // "pochta_rf", "cdek", etc.
  shippingCost         Int         @default(0)
  shippingFullName     String?
  shippingAddress      String?
  shippingCity         String?
  shippingRegion       String?
  shippingPostalCode   String?
  shippingCountry      String      @default("RU")
  cdekTrackingNumber   String? // Номер накладной СДЭК

  // Totals
  subtotal             Int // сумма товаров
  total                Int // subtotal + shipping

  // Promo participation
  participatesInPromo  Boolean     @default(false)
  hasReturnRight       Boolean     @default(true)
  entryCode            String?     @unique

  // Referral tracking
  countedForReferral   Boolean     @default(false)

  // Antifraud fields
  ipAddress            String?
  deviceFingerprint    String?
  fraudScore           Int         @default(0) // 0-100, higher = more suspicious
  fraudFlags           Json? // array of fraud indicators

  // Metadata
  notes                String?     @db.Text
  metadata             Json?

  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  deletedAt            DateTime?

  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  address    Address?    @relation(fields: [addressId], references: [id], onDelete: SetNull)
  items      OrderItem[]
  payments   Payment[]
  shipments  Shipment[]
  entries    Entry[]

  @@index([orderNumber])
  @@index([userId])
  @@index([email])
  @@index([status])
  @@index([entryCode])
  @@map("orders")
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  variantId       String
  quantity        Int
  priceAtPurchase Int // цена на момент заказа
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id             String          @id @default(cuid())
  orderId        String
  provider       PaymentProvider
  status         PaymentStatus   @default(PENDING)
  amount         Int
  currency       String          @default("RUB")
  transactionId  String?         @unique
  confirmationUrl String?
  metadata       Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([transactionId])
  @@map("payments")
}

model Shipment {
  id           String         @id @default(cuid())
  orderId      String
  trackingCode String?
  carrier      String?
  status       ShipmentStatus @default(PENDING)
  shippedAt    DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([trackingCode])
  @@map("shipments")
}

// ==================== PROMO & DRAWS ====================

model Prize {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  image       String?
  value       Int? // примерная стоимость в копейках
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  draws Draw[]

  @@map("prizes")
}

model Draw {
  id          String     @id @default(cuid())
  name        String
  description String?    @db.Text
  prizeId     String?
  status      DrawStatus @default(UPCOMING)
  startsAt    DateTime
  endsAt      DateTime
  seed        String? // для воспроизводимого розыгрыша
  winnerId    String?
  metadata    Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  prize   Prize?  @relation(fields: [prizeId], references: [id], onDelete: SetNull)
  entries Entry[]

  @@index([status])
  @@index([startsAt])
  @@index([endsAt])
  @@map("draws")
}

model Entry {
  id              String    @id @default(cuid())
  uniqueCode      String    @unique
  userId          String?
  orderId         String?
  drawId          String?
  weight          Int       @default(1) // вес шанса
  source          String? // "order", "referral"
  metadata        Json?

  // Antifraud fields
  isActive        Boolean   @default(true) // false if annulled due to refund/fraud
  annulledAt      DateTime? // when was annulled
  annulledReason  String? // "refund", "return", "fraud", "duplicate"

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  order  Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  draw   Draw?   @relation(fields: [drawId], references: [id], onDelete: SetNull)

  @@index([uniqueCode])
  @@index([userId])
  @@index([drawId])
  @@index([isActive])
  @@map("entries")
}

// ==================== REFERRALS ====================

model ReferralLink {
  id        String   @id @default(cuid())
  code      String   @unique
  ownerId   String
  utm       Json?
  clicks    Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  hits  ReferralHit[]

  @@index([code])
  @@index([ownerId])
  @@map("referral_links")
}

model ReferralHit {
  id               String    @id @default(cuid())
  referralLinkId   String
  ipAddress        String?
  userAgent        String?
  convertedOrderId String?
  createdAt        DateTime  @default(now())

  referralLink ReferralLink @relation(fields: [referralLinkId], references: [id], onDelete: Cascade)

  @@index([referralLinkId])
  @@map("referral_hits")
}

// ==================== SETTINGS & AUDIT ====================

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?  // Описание настройки
  category    String?  // Категория (cdek, site, payment, etc.)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
  @@index([category])
  @@map("settings")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  changes   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ==================== LEGAL COMPLIANCE (152-ФЗ) ====================

model LegalDoc {
  id          String   @id @default(cuid())
  docKey      String   // 'privacy', 'consent', 'cookies', 'offer', 'promo-rules'
  version     String   // '1.0', '1.1', etc.
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([docKey, version])
  @@index([docKey])
  @@index([publishedAt])
  @@map("legal_docs")
}

model Consent {
  id         String   @id @default(cuid())
  userId     String?
  formType   String   // 'checkout', 'registration', 'newsletter', 'promo'
  docKey     String   // 'privacy', 'consent', 'promo-rules'
  docVersion String   // версия документа на момент согласия
  ipAddress  String?
  userAgent  String?
  metadata   Json?    // дополнительные данные (e.g. orderId, referralCode)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([formType])
  @@index([docKey, docVersion])
  @@index([createdAt])
  @@map("consents")
}
// ==================== SELLER PAYOUTS ====================

enum PayoutStatus {
  PENDING    // Ожидает обработки
  PROCESSING // В обработке
  COMPLETED  // Выплачено
  REJECTED   // Отклонено
}

model Payout {
  id              String        @id @default(cuid())
  sellerId        String
  amount          Int           // Сумма в копейках
  status          PayoutStatus  @default(PENDING)
  bankAccount     String        // Счет на момент запроса
  bankName        String
  bankBik         String
  rejectReason    String?       // Причина отказа
  processedAt     DateTime?
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  seller User @relation(fields: [sellerId], references: [id])

  @@index([sellerId])
  @@index([status])
  @@index([createdAt])
  @@map("payouts")
}
